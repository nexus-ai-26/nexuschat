WHATSAPP_HOST=http://localhost:3000
WHATSAPP_BASIC_AUTH_USER=admin
WHATSAPP_BASIC_AUTH_PASSWORD=admin
VOYAGE_API_KEY=your_voyage_api_key
DB_URI=postgresql+asyncpg://user:password@localhost:5432/postgres
LOG_LEVEL=INFO
# Gemini is the default provider. Start without AI while setting up WhatsApp/DB.
MODEL_NAME=google-gla:gemini-2.5-flash
AI_ENABLED=false
# Set a real key and AI_ENABLED=true when ready to enable AI features.
# GOOGLE_API_KEY=your-google-ai-studio-key
LOGFIRE_SEND_TO_LOGFIRE=false

# LLM providers are tried in this order. Providers without an API key are skipped.
LLM_PROVIDER_ORDER=openai,deepseek,groq,openrouter,gemini,nvidia
OPENAI_API_KEY=your-openai-key-here
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=sk-your-key-here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-turbo-preview
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
NVIDIA_API_KEY=your-nvidia-key-here

# Runtime limits. Live replies use the agent limit; ingestion/sync jobs use the lower background limit.
AGENT_CONCURRENCY_LIMIT=4
BACKGROUND_CONCURRENCY_LIMIT=1
REPLY_DEADLINE_SECONDS=45
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_PERMANENT_COOLDOWN_SECONDS=3600
PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=60
SEND_RETRY_ATTEMPTS=3
FAILURE_REPLY_COOLDOWN_SECONDS=600
CATCHUP_WINDOW_HOURS=1
CATCHUP_MAX_REPLIES=5
CATCHUP_DELAY_SECONDS=2.5
CATCHUP_START_DELAY_SECONDS=30
CATCHUP_ADMIN_SECRET=choose-a-secret
OTHER_BOT_JIDS=

LOGFIRE_TOKEN=your-key-here

# Do NOT wrap these lists in quotes, as that may cause JSON parsing errors in some environments (Docker/Linux).
QA_TESTERS=["2501234567@s.whatsapp.net", "1543210987@s.whatsapp.net"]
QA_TEST_GROUPS=["120363413079068449@g.us", "120363428762021095@g.us"]
KB_EXCLUDE_SUBJECT_PREFIXES=["Hackathon inquiry"]
